{
  "name": "afyia-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prerender:routes": "node scripts/gen-prerender-routes.mjs",
    "build": "npm run prerender:routes && ng build --configuration production",
    "build-dev": "npm run prerender:routes && ng build --configuration development",
    "build-preprod": "npm run prerender:routes && ng build --configuration preproduction",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start-api": "nodemon api/server.js",
    "create-snapshot": "docker compose exec directus npx directus schema snapshot /directus/database/snapshot.yaml",
    "apply-snapshot": "docker compose exec directus npx directus schema apply /directus/database/snapshot.yaml"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.14",
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/forms": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@angular/platform-browser-dynamic": "^18.2.14",
    "@angular/platform-server": "^18.2.14",
    "@angular/router": "^18.2.14",
    "@angular/ssr": "^18.2.21",
    "@fortawesome/angular-fontawesome": "^0.15.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "locomotive-scroll": "^5.0.1",
    "multer": "^2.0.2",
    "ngx-cookie-service": "^18.0.0",
    "rxjs": "~7.8.0",
    "scrollreveal": "^4.0.9",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.14",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@types/scrollreveal": "^0.0.11",
    "autoprefixer": "^10.4.20",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.41",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.4.2"
  }
}